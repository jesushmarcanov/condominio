# Database Configuration
# Use your local MySQL/MariaDB credentials
DB_HOST=localhost
DB_NAME=condominio_db
DB_USER=your-db-user
DB_PASS=your-db-password

# Email Configuration
# Choose driver: smtp or sendgrid
MAIL_DRIVER=smtp

# SMTP Configuration (for Gmail, Outlook, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@condominio.com
MAIL_FROM_NAME=CondoWeb

# SendGrid Configuration (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Test Mode (set to true to log emails instead of sending)
MAIL_TEST_MODE=false

# Payment Test Mode (true = el administrador verifica manualmente cada
# declaración de pago en línea; no hay integración API real)
PAYMENT_TEST_MODE=true
